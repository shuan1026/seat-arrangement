# 本機開發：複製成 .env 後依需要修改。正式環境的值在 aiborn 平台的「環境變數」設定，不放檔案。
# 變數說明見 docs/architecture.md 第 14.2 節。

# ---- 資料庫（平台建立資料庫後「帶入環境變數」會填好前五個）
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3317
DATABASE_NAME=seat_dev
DATABASE_USER=seat
DATABASE_PASSWORD=seat_dev
# 平台要求 SSL（不驗證憑證）；本機 MySQL 8.4 也有自簽憑證，預設開啟
DATABASE_SSL=true
# Prisma 連線池上限（平台個人方案同時最多 10 條連線）
DATABASE_CONNECTION_LIMIT=3

# ---- 測試（每條平行線用自己的一組，見 docs/plan/implementation-plan.md 第 5.3 節）
TEST_DATABASE_NAME=seat_test
E2E_PORT=3100

# ---- 登入（Auth.js v4）
# 產生：openssl rand -base64 32；正式與本機用不同值
NEXTAUTH_SECRET=
# 網站網址；本機為 http://localhost:3000，正式為平台給的網址
NEXTAUTH_URL=http://localhost:3000
# 平台的 Google OAuth 用戶端申請完成後「帶入環境變數」
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 允許登入的公司網域（待確認 Q20）
ALLOWED_EMAIL_DOMAIN=program.com.tw

# ---- 其他
# 寫進 Log 的 env 欄位：dev／prod
APP_ENV=dev
