// 資料設計見 docs/architecture.md 第 7 節。
// 部門、組別、顯示名稱、桌次部門標示、工作人員身分都由資料推導，不另外存。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Employee {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(50)
  englishName String?      @db.VarChar(100)
  department  String       @db.VarChar(50)
  team        String?      @db.VarChar(50) // 組別，選填
  extension   String?      @db.VarChar(50) // 多個分機合併為「1234／1235」；N/A 存 null
  region      String?      @db.VarChar(20)
  office      String?      @db.VarChar(50)
  note        String?      @db.VarChar(500)
  declined    Boolean      @default(false) // 承辦人標記為不參加（D-014）；有參與人員時一律視為已報名，加入尾牙時清掉
  sortOrder   Int // 員工名單順序，決定部門與組別的排序
  participant Participant? @relation("EmployeeParticipant")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name, department])
  @@index([sortOrder])
}

enum ParticipantKind {
  EMPLOYEE
  DEPENDENT
  GUEST
}

model Participant {
  id           Int             @id @default(autoincrement())
  kind         ParticipantKind
  // EMPLOYEE：一位員工最多報名一次
  employeeId   Int?            @unique
  employee     Employee?       @relation("EmployeeParticipant", fields: [employeeId], references: [id], onDelete: Cascade)
  // DEPENDENT：所屬員工的參與人員；unique 確保每位員工最多一位眷屬
  hostId       Int?            @unique
  host         Participant?    @relation("Dependent", fields: [hostId], references: [id], onDelete: Cascade)
  dependent    Participant?    @relation("Dependent")
  relation     String?         @db.VarChar(20) // 眷屬稱謂
  guestName    String?         @db.VarChar(50) // 外部貴賓姓名
  organization String?         @db.VarChar(100) // 外部貴賓單位
  title        String?         @db.VarChar(50) // 外部貴賓頭銜
  childSeat    Boolean         @default(false)
  vegetarian   Boolean         @default(false)
  note         String?         @db.VarChar(500)
  // null = 未入座；工作人員桌的 id 是 0
  tableId      Int?
  table        SeatTable?      @relation(fields: [tableId], references: [id])
  seatOrder    Int? // 桌內名單順序，0 起算
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tableId, seatOrder])
}

enum TableKind {
  NORMAL
  STAFF
}

// 桌子（D-027）：名單、順序與備註名稱。position 是所在位置 1–30（桌號由 src/domain/layout.ts 對應），null 是暫存區；
// 工作人員桌 id 0、kind STAFF、position null。既有 30 桌的 id 是 1–30；新增的桌由服務層取最大 id 加 1（docs/architecture.md 第 7.1 節）
model SeatTable {
  id           Int           @id
  kind         TableKind
  position     Int?          @unique // 一個位置只能有一張桌；MySQL 的 unique 允許多個 null（暫存區）
  stagedAt     DateTime?     // 移到暫存區的時間，暫存區依這個由上往下排；在位置上時是 null
  noteName     String?       @db.VarChar(50) // 備註名稱
  participants Participant[]
  updatedAt    DateTime      @updatedAt
}


// 權限名單上的身分（D-026）
enum MemberRole {
  EDITOR // 編輯者
  VIEWER // 檢視者
}

// 權限名單（D-021、D-026）：名單上的 email 依 role 是編輯者或檢視者，其他公司帳號沒有權限、只能看發布頁。
// 身分每個請求查一次，不放進 JWT（docs/architecture.md 第 9.3 節）。
model Member {
  id        Int        @id @default(autoincrement())
  email     String     @unique @db.VarChar(254) // 一律去空白、轉小寫後存（PRM-R03）
  role      MemberRole // 新增時一定指定；啟動時由 INITIAL_EDITOR_EMAILS 寫入的是 EDITOR
  createdAt DateTime   @default(now()) // 權限頁依這個欄位排序，改權限不改（PRM-R07）
  createdBy String?    @db.VarChar(254) // 新增者的 email；啟動時由 INITIAL_EDITOR_EMAILS 寫入的是 null
}


// 全站設定：單列表，只有 id = 1 這一列，由新增它的 migration 用 INSERT 建好
model Setting {
  id             Int      @id @default(1)
  seatsPublished Boolean  @default(false) // 發布頁是否開放（D-021）
  updatedAt      DateTime @updatedAt
}
